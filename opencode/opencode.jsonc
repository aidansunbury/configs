{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    // "@franlol/opencode-md-table-formatter@0.0.3",
    "opencode-cmux",
  ],
  "permission": {
    "external_directory": "allow",
  },
  "references": {
    "opencode": {
      "repository": "anomalyco/opencode",
      "description": "Use for OpenCode implementation details, configuration, and documentation conventions",
    },
    "coder": {
      "repository": "coder/coder",
      "description": "Use for Coder workspace platform implementation details",
    },
    "executor": {
      "repository": "rhyssullivan/executor",
      "description": "Use for Executor implementation details and MCP behavior",
    },
    "infisical": {
      "repository": "Infisical/infisical",
      "description": "Use for Infisical secrets management implementation details",
    },
  },
  "mcp": {
    "executor":{
      "enabled": true,
      "type": "remote",
      "url": "https://executor.sh/mcp"
    },
    "sightglass": {
      "enabled": true,
      "type": "remote",
      "url": "http://localhost:4444/api/mcp",
    },
  },
  "provider": {
    "openrouter":{
      "options": {
        "baseURL": "http://ai.geep-monster.ts.net/v1",
      },
    }
  },
  "experimental": {
    "disable_paste_summary": true,
  },
}
