{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/zen-k2.5",
  "plugin": [
    "@franlol/opencode-md-table-formatter@0.0.3",
    "@mohak34/opencode-notifier@latest",
  ],
  "agent": {
    "docs": {
      "permission": {
        "external_directory": {
          "~/.docs-agent/**": "allow",
        },
      },
    },
  },
  "mcp": {
    "buildkite": {
      "enabled": false,
      "type": "remote",
      "url": "https://mcp.buildkite.com/mcp/readonly",
    },
    "datadog": {
      "enabled": false,
      "type": "remote",
      "url": "https://mcp.datadoghq.com/api/unstable/mcp-server/mcp",
    },
    "linear": {
      "enabled": false,
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
    },
    "notion": {
      "enabled": false,
      "type": "remote",
      "url": "https://mcp.notion.com/mcp",
    },
    "cachebro": {
      "type": "local",
      "command": ["npx", "cachebro", "serve"],
    },
    "codemogger": {
      "command": "npx",
      "args": ["-y", "codemogger", "mcp"],
    },
    "sightglass": {
      "enabled": true,
      "type": "remote",
      "url": "http://localhost:4444/api/mcp",
    },
  },
  "experimental": {
    "disable_paste_summary": true,
  },
}
