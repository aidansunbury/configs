{
  "$schema": "https://opencode.ai/config.json",
  "theme": "system",
  "model": "opencode/zen-k2.5",
  "plugin": ["@franlol/opencode-md-table-formatter@0.0.3","@mohak34/opencode-notifier@latest"],
  "agent": {
    "docs": {
      "permission": {
        "external_directory": {
          "~/.docs-agent/**": "allow"
        }
      }
    }
  },
  "mcp": {
    "datadog": {
      "type": "remote",
      "url": "https://mcp.datadoghq.com/api/unstable/mcp-server/mcp"
    }
  }
}
